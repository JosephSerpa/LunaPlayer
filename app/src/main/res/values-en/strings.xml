    <string name="srv_sync_user_title">Playlists, likes and stars</string>
    <string name="srv_sync_user_error">Could not sync; will retry.</string>
    <string name="srv_sync_user_help">Stores your playlists, likes and star ratings for the server\'s music on your server and keeps them identical on all your devices. Music that is only on the phone is not synced. The first time it is turned on, this device\'s data is merged with the server\'s without deleting anything.</string>
    <string name="backup_title">Backup</string>
    <string name="backup_help">Saves your likes, stars, playlists, plays, equalizer, widgets and settings to a file. With it you can restore everything after reinstalling or move it to another device. Songs are recognised by title, artist and length, so it works on another phone too. Server and Last.fm credentials are not included.</string>
