<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: tampoco en la copia en la nube ni al pasar los datos a otro teléfono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="server.xml" />
        <exclude domain="sharedpref" path="lastfm.xml" />
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="sharedpref" path="widget.xml" />
        <exclude domain="database" path="server_library.db" />
        <exclude domain="database" path="server_library.db-wal" />
        <exclude domain="database" path="server_library.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server.xml" />
        <exclude domain="sharedpref" path="lastfm.xml" />
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="sharedpref" path="widget.xml" />
        <exclude domain="database" path="server_library.db" />
        <exclude domain="database" path="server_library.db-wal" />
        <exclude domain="database" path="server_library.db-shm" />
    </device-transfer>
</data-extraction-rules>
